.hud {
    flex-grow: 1;
}

/* The two vitals, stacked. HP and fullness are the same KIND of thing — a state of the body with a
   ceiling — so they are built from one set of classes and differ only in colour. That is what stops the
   old "why does only food have a limit" question: nobody asks it about a health bar. */
.vitals {
    position: absolute;
    top: 16px;
    right: 16px;
    align-items: flex-end;
}

.vital {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.vital-track {
    width: 400px;
    height: 44px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 11px;
    overflow: hidden;
    justify-content: center;
}

.health-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(214, 58, 58);
    transition-property: width;
    transition-duration: 0.12s;
}

.hunger-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(214, 154, 58);
    transition-property: width;
    transition-duration: 0.12s;
}

/* The well-fed line, drawn ON the bar. Above it HP climbs, at zero HP drains — a rule the player can see
   is a rule nobody has to be told. Its left offset is set from the config at runtime, so moving the
   threshold moves the mark. */
.hunger-mark {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.55);
}

.vital-text {
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
}

/* Each bar is labelled by its own icon, sitting to the right so both bars stay flush with the screen
   edge and the two icons line up in a column. */
.vital-icon {
    width: 66px;
    height: 66px;
    margin-left: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.health-icon {
    background-image: url("project://database/Assets/_Project/Art/Icons/heart.png");
}

.hunger-icon {
    background-image: url("project://database/Assets/_Project/Art/Icons/stomach.png");
}

.inventory {
    position: absolute;
    top: 160px;
    right: 16px;
    align-items: flex-end;
}

/* The backpack readout. Kept as its own class so a second chip beside it stays a one-liner. */
.chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 8px;
    padding: 6px 10px;
    border-width: 0;
    transition-duration: 0.08s;
}

.capacity:hover {
    background-color: rgba(0, 0, 0, 0.7);
    scale: 1.03 1.03;
}

.bag-icon {
    width: 109px;
    height: 109px;
    background-image: url("project://database/Assets/_Project/Art/Icons/Backpack_Build.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 10px;
    transition-property: scale;
    transition-duration: 0.09s;
    transform-origin: center;
}

.cap-text {
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-font-style: bold;
}

.item-list {
    margin-top: 6px;
    align-items: flex-end;
}

.item-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 6px;
    padding: 3px 8px;
    margin-top: 4px;
}

.item-count {
    color: rgb(255, 255, 255);
    font-size: 29px;
    -unity-font-style: bold;
    margin-right: 8px;
    min-width: 44px;
    -unity-text-align: middle-right;
}

.item-icon {
    width: 86px;
    height: 86px;
    -unity-background-scale-mode: scale-to-fit;
}

.fly-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.fly-icon {
    position: absolute;
    left: -9999px;              /* parked off-screen until rented; Place() drives the real position */
    top: -9999px;
    width: 86px;
    height: 86px;
    -unity-background-scale-mode: scale-to-fit;
}
