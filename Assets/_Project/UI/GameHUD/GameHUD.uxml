<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Badge.uss" />
    <Style src="project://database/Assets/_Project/UI/GameHUD/GameHUD.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <!-- One cluster, because it is all one question: who am I and how am I doing. The portrait carries
             the level as a badge and the experience as the sliver under it; the two vitals sit alongside.
             Splitting them across two corners made the player look in two places to answer one thing. -->
        <ui:VisualElement name="player-panel" class="player-panel" picking-mode="Ignore">
            <!-- The way into the character window, and the only one: pressing the face is how you look at
                 yourself. Picking is ON here and left off on everything inside, so a press anywhere on the
                 portrait or its bar lands on this element rather than on whichever label was topmost. -->
            <ui:VisualElement name="avatar-block" class="avatar-block">
                <ui:VisualElement name="level-avatar" class="level-avatar" picking-mode="Ignore">
                    <ui:Label name="level-text" class="level-badge" text="1" picking-mode="Ignore" />
                    <ui:Label name="avatar-badge" text="!" class="badge badge--avatar" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="level-track" class="level-track" picking-mode="Ignore">
                    <ui:VisualElement name="level-fill" class="level-fill" picking-mode="Ignore" />
                    <ui:Label name="level-exp" class="level-exp" text="0/0" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="vitals" class="vitals" picking-mode="Ignore">
                <ui:VisualElement name="health" class="vital" picking-mode="Ignore">
                    <ui:VisualElement name="health-track" class="vital-track" picking-mode="Ignore">
                        <ui:VisualElement name="health-fill" class="health-fill" picking-mode="Ignore" />
                        <ui:Label name="health-text" class="vital-text" text="0/0" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="health-icon" class="vital-icon health-icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="hunger" class="vital" picking-mode="Ignore">
                    <ui:VisualElement name="hunger-track" class="vital-track" picking-mode="Ignore">
                        <ui:VisualElement name="hunger-fill" class="hunger-fill" picking-mode="Ignore" />
                        <ui:VisualElement name="hunger-mark" class="hunger-mark" picking-mode="Ignore" />
                        <ui:Label name="hunger-text" class="vital-text" text="0/0" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="hunger-icon" class="vital-icon hunger-icon" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="inventory" class="inventory">
            <ui:Button name="capacity-button" class="chip capacity">
                <ui:VisualElement name="bag-icon" class="bag-icon" picking-mode="Ignore" />
                <ui:Label name="capacity-label" class="cap-text" text="0" />
            </ui:Button>
            <ui:VisualElement name="item-list" class="item-list" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="fly-layer" class="fly-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
