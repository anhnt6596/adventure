<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/GameUI/GameUI.uss" />
    <ui:VisualElement name="screen" class="screen" picking-mode="Ignore">
        <ui:VisualElement name="bottom-bar" class="bottom-bar">
            <ui:Button name="start-button" text="START" class="start-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Editor-only cheat drawer. Sibling of "screen" so it outlives START; GameUI strips it in a build. -->
    <ui:VisualElement name="cheat" class="cheat" picking-mode="Ignore">
        <ui:VisualElement name="cheat-panel" class="cheat-panel">
            <ui:Label text="CHEATS" class="cheat-title" />
            <!-- A ScrollView, not a plain box: tools only ever get added, and the one that overflows would
                 otherwise be invisible with nothing saying so. -->
            <ui:ScrollView name="cheat-tools" class="cheat-tools">
                <ui:VisualElement class="cheat-tool">
                    <ui:Label text="Character" class="cheat-tool-title" />
                    <ui:VisualElement class="cheat-row">
                        <ui:DropdownField name="mc-dropdown" class="cheat-field" />
                        <ui:Button name="change-mc-button" text="Change" class="cheat-btn cheat-btn-inline" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="cheat-tool">
                    <ui:Label text="Stats" class="cheat-tool-title" />
                    <ui:VisualElement name="stat-list" class="cheat-kv-list" />
                </ui:VisualElement>
                <ui:VisualElement class="cheat-tool">
                    <ui:Label text="Vitals" class="cheat-tool-title" />
                    <ui:Slider name="hp-slider" label="HP" low-value="0" high-value="1" show-input-field="true" class="cheat-slider" />
                    <ui:Slider name="hunger-slider" label="Full" low-value="0" high-value="1" show-input-field="true" class="cheat-slider" />
                    <ui:Toggle name="no-hunger-toggle" label="Never hungry" class="cheat-check" />
                    <ui:Toggle name="invincible-toggle" label="Invincible" class="cheat-check" />
                </ui:VisualElement>
                <ui:VisualElement class="cheat-tool">
                    <ui:Label text="Level" class="cheat-tool-title" />
                    <ui:Label name="level-readout" class="cheat-readout" text="—" />
                    <ui:VisualElement class="cheat-row">
                        <ui:IntegerField name="exp-field" label="Add exp" value="50" class="cheat-field" />
                        <ui:Button name="add-exp-button" text="Add" class="cheat-btn cheat-btn-inline" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cheat-row">
                        <ui:IntegerField name="level-field" label="Set level" value="1" class="cheat-field" />
                        <ui:Button name="set-level-button" text="Set" class="cheat-btn cheat-btn-inline" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cheat-row">
                        <ui:IntegerField name="point-field" label="Add points" value="5" class="cheat-field" />
                        <ui:Button name="add-point-button" text="Add" class="cheat-btn cheat-btn-inline" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="cheat-tool">
                    <ui:Label text="Bag" class="cheat-tool-title" />
                    <ui:VisualElement name="bag-list" class="cheat-bag-list" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:Button name="cheat-toggle" text="»" class="cheat-toggle" />
    </ui:VisualElement>
</ui:UXML>
