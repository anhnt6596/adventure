/* transparent full-screen overlay: only the button is clickable (picking-mode=Ignore elsewhere) */
.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-end;
}

.bottom-bar {
    align-items: center;
    padding-bottom: 48px;
}

.start-btn {
    width: 220px;
    height: 56px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
    background-color: rgb(235, 200, 90);
    border-width: 0;
    border-radius: 10px;
}

.start-btn:hover {
    background-color: rgb(245, 215, 120);
    scale: 1.03 1.03;
}

.start-btn:active {
    scale: 0.97 0.97;
}

/* Cheat drawer (editor only). The strip hugs the left edge and is content-width, so it never covers the
   play area; picking-mode=Ignore on it means only the tab + panel take clicks. */
.cheat {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
}

.cheat-panel {
    display: none;   /* the tab opens it */
    align-self: stretch;
    width: 620px;
    margin: 16px 0;
    padding: 16px;
    background-color: rgba(18, 20, 26, 0.94);
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

.cheat-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(235, 200, 90);
    margin-bottom: 12px;
}

/* where cheat tools get appended */
.cheat-tools {
    flex-grow: 1;
}

/* Each tool is a CARD, not a gap. Spacing alone stopped saying where one tool ended once there were more
   than three of them — a panel of controls all styled alike reads as one long list of them. */
.cheat-tool {
    margin-bottom: 12px;
    padding: 10px 14px 12px 14px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border-left-width: 3px;
    border-left-color: rgb(235, 200, 90);
}

.cheat-tool-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(235, 200, 90);
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.14);
}

/* a control and the button that acts on it, side by side — reading down a column of full-width buttons
   made every tool look the same height and none of them look connected to its own field */
.cheat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.cheat-field {
    flex-grow: 1;
    margin: 0;
    font-size: 26px;
}

.cheat-btn {
    height: 46px;
    margin: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
    background-color: rgb(235, 200, 90);
    border-width: 0;
    border-radius: 6px;
}

.cheat-btn-inline {
    width: 110px;
    margin-left: 10px;
}

.cheat-btn:hover {
    background-color: rgb(245, 215, 120);
}

/* greyed while the picked character is already the live one */
.cheat-btn:disabled {
    opacity: 0.35;
}

/* HP / fullness. Both carry a number field as well as the track: the tracks are short, and setting an
   exact value is half of what these are for. */
.cheat-slider {
    margin: 0 0 8px 0;
    height: 38px;
}

.cheat-check {
    margin: 0 0 4px 0;
    height: 34px;
}

/* ---- built-in control internals -------------------------------------------------------------------
   Unity's Slider, Toggle and DropdownField carry their own default styling, which is dark text meant for
   a light inspector. On this panel that is black on black, and their parts do not inherit font-size — so
   each one has to be named. This is the whole reason the block below exists. */

.cheat-panel .unity-base-field__label,
.cheat-panel .unity-toggle__text {
    font-size: 26px;
    color: rgb(214, 219, 230);
    min-width: 170px;
    -unity-text-align: middle-left;
}

.cheat-panel .unity-base-slider__tracker {
    background-color: rgb(58, 63, 76);
    border-width: 0;
    border-radius: 4px;
    height: 10px;
}

.cheat-panel .unity-base-slider__dragger {
    background-color: rgb(235, 200, 90);
    border-width: 0;
    border-radius: 12px;
    width: 26px;
    height: 26px;
    margin-top: -13px;
}

/* the number box beside a slider, and the dropdown's own field */
.cheat-panel .unity-base-text-field__input,
.cheat-panel .unity-base-popup-field__input {
    font-size: 26px;
    color: rgb(240, 242, 248);
    background-color: rgb(38, 42, 52);
    border-width: 0;
    border-radius: 5px;
    padding: 4px 8px;
    min-width: 110px;
}

/* only where a field shares its row with a button, so the two line up. Left off the general rule because a
   slider's number box lives inside a shorter row and would burst out of it. */
.cheat-row .unity-base-text-field__input,
.cheat-row .unity-base-popup-field__input {
    height: 46px;
}

.cheat-panel .unity-base-popup-field__text {
    font-size: 26px;
    color: rgb(240, 242, 248);
}

.cheat-panel .unity-toggle__checkmark {
    width: 34px;
    height: 34px;
    border-radius: 5px;
}

/* a line of live text a tool reports about itself, rather than a control */
.cheat-readout {
    font-size: 26px;
    color: rgb(210, 214, 224);
    margin-bottom: 8px;
}

/* Name and number, two to a line: nine stats down a single column pushed everything under it off the
   panel, and a stat readout is short enough that half a width is plenty. */
.cheat-kv-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.cheat-stat-row {
    width: 50%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 2px 14px 2px 0;
}

.cheat-stat-name {
    font-size: 22px;
    color: rgb(160, 166, 180);
}

.cheat-stat-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 242, 248);
}

/* one row per resource kind in the bag */
.cheat-bag-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.cheat-bag-name {
    flex-grow: 1;
    font-size: 26px;
    color: rgb(210, 214, 224);
}

.cheat-bag-remove {
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
    background-color: rgb(220, 120, 110);
    border-width: 0;
    border-radius: 4px;
}

.cheat-bag-remove:hover {
    background-color: rgb(235, 140, 130);
}

.cheat-bag-empty {
    font-size: 24px;
    -unity-font-style: italic;
    color: rgb(140, 146, 158);
}

/* Deliberately chunky: PanelSettings scales with screen size, so a thin tab ends up near-unclickable. */
.cheat-toggle {
    width: 64px;
    height: 180px;
    margin: 0;
    padding: 0;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
    background-color: rgb(235, 200, 90);
    border-width: 0;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

.cheat-toggle:hover {
    background-color: rgb(245, 215, 120);
}
