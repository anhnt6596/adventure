<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Popups/UpgradePopup.uss" />
    <!-- BasePopup queries "dimmer" and "popup" by name, so those two are not free to be renamed. -->
    <ui:VisualElement name="dimmer" class="dimmer">
        <ui:VisualElement name="popup" class="popup">

            <ui:VisualElement name="head" class="head">
                <ui:VisualElement name="avatar" class="head-avatar" />
                <ui:VisualElement class="head-titles">
                    <ui:Label name="char-name" text="—" class="head-name" />
                    <ui:Label name="points" text="" class="head-points" />
                </ui:VisualElement>
                <ui:Button name="reset-button" text="Reset" class="btn btn--ghost" />
                <ui:Button name="close-button" text="✕" class="close-btn" />
            </ui:VisualElement>

            <ui:VisualElement name="body" class="body">
                <!-- The nodes are added to "tree-canvas" from code, over "tree-edges" which paints the links. -->
                <ui:ScrollView name="tree-scroll" class="tree-scroll">
                    <ui:VisualElement name="tree-canvas" class="tree-canvas">
                        <ui:VisualElement name="tree-edges" class="tree-edges" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:Label name="empty" text="No upgrade tree authored for this character yet." class="empty" />

            <!-- OUTSIDE the tree, and last, so it draws over the header and is not clipped by the scroll view
                 the way it was while it lived in the canvas. Code places it over the selected node, in this
                 element's coordinates, and re-places it whenever the tree scrolls under it. -->
            <ui:VisualElement name="tip" class="tip">
                <ui:Label name="tip-text" text="" class="tip-text" />
                <ui:Button name="buy-button" text="Unlock" class="btn tip-buy" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
