/* The upgrade PAGE, not a window: the shell it sits in (.dimmer, .popup, .head, the tab strip) is
   CharacterPopup.uss, and everything here is furniture only this tab has. Instanced into the window by
   CharacterPopup.uxml, which is also what gives the page its .tab-page container.

   SIZES ARE CHUNKY ON PURPOSE, and match the rest of the game rather than a desktop inspector. PanelSettings
   scales the whole UI with the screen, so anything authored at "looks fine on my monitor" ends up unreadable
   on a phone — the HUD is already built at 28-34px for the same reason. */

/* The row above the tree: points to spend on the left, respec on the right. */
.upgrade-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px 0 28px;
}

.upgrade-points {
    font-size: 26px;
    color: rgb(235, 200, 90);
}

/* ---- body ---- */

.body {
    flex-grow: 1;
    flex-direction: row;
}

.tree-scroll {
    flex-grow: 1;
}

/* Sized from code off what the tree occupies, so a tree that grows does not need this widened by hand. */
.tree-canvas {
    position: relative;
}

.tree-edges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---- nodes ---- */

.node {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 4px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(26, 28, 38);
    border-color: rgba(255, 255, 255, 0.18);
    transition-property: scale, background-color;
    transition-duration: 0.09s;
}

.node:hover {
    scale: 1.08 1.08;
}

.node-icon {
    width: 68px;
    height: 68px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Every node wears its price. It used to appear only above one point, so that the dear ones stood out — but
   that leaves the player working out what the ordinary price even is, and the tree is the one screen where
   the answer should never need working out. */
.node-cost {
    position: absolute;
    bottom: -10px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
    background-color: rgb(235, 200, 90);
    border-radius: 13px;
    padding: 1px 11px;
}

/* Four states, and the colour is the whole readout: owned, affordable now, unlocked but unaffordable,
   and still walled off behind a node further in. */
.node--root {
    border-color: rgb(235, 200, 90);
    background-color: rgb(58, 50, 24);
}

/* The brightest fill of the four. Owned is the state the player is collecting, so it should read as lit from
   the inside rather than as a darker shade of the same disc — and the icon, which is what actually says what
   the node IS, only comes off the background when the background is well clear of it. */
.node--bought {
    border-color: rgb(140, 220, 150);
    background-color: rgb(56, 104, 66);
}

.node--ready {
    border-color: rgb(235, 200, 90);
}

/* Dimmed by COLOUR, never by opacity: a translucent node lets the link lines run straight through it, so a
   node that cannot be bought stops looking like an object and starts looking like a hole. */
.node--short {
    border-color: rgb(96, 84, 46);
    background-color: rgb(22, 23, 30);
}

.node--locked {
    border-color: rgb(46, 48, 56);
    background-color: rgb(19, 20, 26);
}

.node--selected {
    border-color: rgb(255, 255, 255);
}

/* ---- tooltip ----
   Hung off the node itself rather than parked in a column down the side. A panel over there makes you look
   away from the thing you clicked and back again to check it was the right one; here what a node does is
   written where the node is.

   Code places it at the node's top edge; the translate pulls it back half its own width and its whole height,
   so it sits centred ABOVE the node without this file ever having to know how big it turned out to be. Above
   rather than below because the thing you press next is the node itself, and a panel under it lands where the
   finger already is. */
.tip {
    position: absolute;
    display: none;   /* code shows it for the selected node */
    width: 340px;
    padding: 18px 20px;
    translate: -50% -100%;
    background-color: rgba(16, 18, 24, 0.97);
    border-width: 2px;
    border-color: rgba(235, 200, 90, 0.5);
    border-radius: 12px;
}

.tip-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
    white-space: normal;
}

.tip-buy {
    height: 52px;
    margin-top: 14px;
    font-size: 22px;
}

.btn {
    height: 64px;
    margin-top: 22px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(20, 22, 28);
    background-color: rgb(235, 200, 90);
    border-width: 0;
    border-radius: 10px;
}

.btn:hover {
    background-color: rgb(245, 215, 120);
}

.btn:disabled {
    opacity: 0.35;
}

.btn--ghost {
    height: 52px;
    margin-top: 0;
    padding: 0 22px;
    font-size: 22px;
    color: rgb(230, 230, 235);
    background-color: rgba(255, 255, 255, 0.1);
}

.btn--ghost:hover {
    background-color: rgba(255, 255, 255, 0.18);
}

.empty {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 28px;
    color: rgb(150, 152, 162);
}
